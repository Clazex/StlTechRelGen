<Project Sdk="Microsoft.NET.Sdk">
	<!-- Assembly Identity -->
	<PropertyGroup>
		<!--
			This is used by update checker, and therefore must be
			the same as git tag name but with no "v" prefix
		-->
		<Version>0.1.0</Version>
		<RootNamespace>StlTechRelGen</RootNamespace>
		<AssemblyTitle>Stellaris Tech Relation Generator</AssemblyTitle>
		<Product>$(AssemblyTitle)</Product>
		<Description>Generates augment info for Stellaris techs from game data with mod support</Description>
		<Company>Clazex</Company>
		<Copyright>Copyright (c) 2026 Clazex</Copyright>
	</PropertyGroup>

	<!-- Language & Analysis -->
	<PropertyGroup>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AnalysisMode>Recommended</AnalysisMode>
		<NoWarn>$(NoWarn);CA1716</NoWarn> <!-- Suppression: mod is reserved keyword -->
	</PropertyGroup>

	<!-- Build -->
	<PropertyGroup>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RuntimeIdentifiers>win-x64;linux-x64;osx-arm64</RuntimeIdentifiers>
		<DebugType>portable</DebugType>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
	</PropertyGroup>

	<!-- Publish -->
	<PropertyGroup>
		<!--
			Despite the MonoMod warning, this does not cause actual runtime
			errors for this project. Enable it for now.
		-->
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>false</SelfContained>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	</PropertyGroup>

	<PropertyGroup Condition="$(Configuration) == 'Release'">
		<PathMap>$(MSBuildProjectDirectory)=/</PathMap>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(CI)' == 'true'">
		<RestoreLockedMode>True</RestoreLockedMode>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CWTools" Version="0.5.0-alpha" />
		<PackageReference Include="FSharp.Core" Version="10.1.302" />
		<PackageReference Include="HarmonyX" Version="2.16.1" />

		<PackageReference Include="Tomlyn" Version="2.10.1" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />

		<PackageReference Include="GameFinder" Version="4.9.0" />

		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="SQLitePCLRaw.config.e_sqlite3" Version="3.0.5" />
		<!--
			Use newer shipped native SQLite builds instead of the vulnerable
			SQLitePCLRaw.lib.e_sqlite3 package (CVE-2025-6965) used by
			Microsoft.EntityFrameworkCore.Sqlite
		-->
		<PackageReference Include="SourceGear.sqlite3" Version="3.53.4" />

		<PackageReference Include="Spectre.Console" Version="0.57.2" />
		<PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />

		<PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.10" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources/**" />
	</ItemGroup>

	<ItemGroup Condition="$(Configuration) == 'Debug'">
		<Content Condition="Exists('config.toml')" Include="config.toml">
			<TargetPath>$(AssemblyName).toml</TargetPath>
			<CopyToOutputDirectory>IfDifferent</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
</Project>
